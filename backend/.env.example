NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Neon Postgres — get both from the Neon dashboard "Connection Details" panel.
# DATABASE_URL = pooled connection (host ends in "-pooler", used at runtime).
#   pgbouncer=true&connection_limit=20&connect_timeout=30&pool_timeout=30 avoids
#   "server has closed the connection" errors seen against this Neon compute's
#   cold-start behavior under bursty local dev traffic (connection_limit=20
#   instead of Prisma's default 10, since the public landing page alone fires
#   ~8 parallel queries on first load -- see prisma.ts for the retry logic
#   that handles the remaining cold-start race that a bigger pool alone can't).
# DIRECT_URL   = direct connection (used only by `prisma migrate`)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/dbname?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=20&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/dbname?sslmode=require&channel_binding=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

BCRYPT_SALT_ROUNDS=12

# Used only by prisma/seed.ts to create the single Administrator account
SEED_ADMIN_EMAIL=admin@barangaycatarman.gov.ph
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Administrator

UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

# Resident-facing transactional email (submission confirmations + status
# updates for certificate requests and incident reports). Optional -- if
# SMTP_USER/SMTP_PASSWORD are left unset, emails are skipped (logged as a
# warning) instead of breaking the request that triggered them.
# For Gmail: SMTP_USER is your Gmail address, SMTP_PASSWORD is a 16-character
# "App Password" (myaccount.google.com/apppasswords) -- NOT your normal
# Google account password, which Gmail's SMTP no longer accepts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Barangay Catarman OMS

# Public AI assistant chat widget. Get a key from https://aistudio.google.com/apikey
# Server-side only -- never expose this to the frontend/browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
